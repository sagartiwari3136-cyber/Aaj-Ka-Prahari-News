# ==============================================================================
# Application Runtime Settings
# ==============================================================================
NODE_ENV="development"
PORT="3000"

# Persistence driver ('json' during Phase A; 'postgres' will be enabled in later phases)
STORAGE_DRIVER="json"

# Optional directory for persistent JSON data files (store.json and auth-store.json).
# Leave empty to use "<app-root>/data", or set an absolute path outside Git deploy directories.
DATA_DIR=""

# GEMINI_API_KEY: Required for Gemini AI editorial assistant API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Reverse proxy trust ('false' for direct connections, hop count '1' behind 1 trusted reverse proxy
# such as Hostinger / Nginx / LiteSpeed, or comma-separated subnet/preset like 'loopback'). Never set 'true'.
TRUST_PROXY="false"

# Optional comma-separated allowlist of trusted cross-origin URLs (e.g. "https://cms.example.com").
# Leave empty for strict same-origin only. Wildcard "*" is disallowed.
CORS_ALLOWED_ORIGINS=""

# ==============================================================================
# PostgreSQL Connection Configuration (Object Method — Never use DATABASE_URL)
# ==============================================================================
# Local development host (e.g., localhost or 127.0.0.1) or production host/Unix socket path
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="akp_news"

# Least-privilege application role (SELECT, INSERT, UPDATE, DELETE only)
SQL_USER="akp_app_user"
SQL_PASSWORD="CHANGE_ME_APP_PASSWORD"

# Privileged schema-owner role used exclusively by Drizzle Kit migrations
SQL_ADMIN_USER="akp_admin"
SQL_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# TLS / SSL mode: 'false' (local dev / Auth Proxy), 'true' (strict CA), or 'require'
SQL_SSL="false"

# Connection pool tuning (optional)
SQL_POOL_MAX="10"
SQL_IDLE_TIMEOUT_MS="30000"
SQL_CONNECTION_TIMEOUT_MS="15000"

# ==============================================================================
# Admin Authentication & Session Security (Optional Env Provisioning)
# ==============================================================================
# If unset, first-run Chief Admin setup is performed via /api/admin/bootstrap
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Optional pre-hashed scrypt password (scrypt$<saltHex>$<derivedHex>)
ADMIN_PASSWORD_HASH=""
ADMIN_DISPLAY_NAME=""

# Optional Senior Editor provisioning
EDITOR_USERNAME=""
EDITOR_PASSWORD=""
EDITOR_PASSWORD_HASH=""
EDITOR_DISPLAY_NAME=""

# Session & login rate-limiting settings (buckets are stored in-memory and reset on restart)
ADMIN_SESSION_TTL_HOURS="8"
ADMIN_LOGIN_MAX_ATTEMPTS="5"
ADMIN_LOGIN_WINDOW_MS="900000"
ADMIN_LOGIN_LOCKOUT_MS="900000"
